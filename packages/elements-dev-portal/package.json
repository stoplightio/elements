{
  "name": "@stoplight/elements-dev-portal",
  "version": "4.0.0",
  "description": "UI components for composing beautiful developer documentation.",
  "keywords": [],
  "sideEffects": [
    "web-components.min.js",
    "src/web-components/**",
    "**/*.css"
  ],
  "homepage": "https://github.com/stoplightio/elements",
  "bugs": "https://github.com/stoplightio/elements/issues",
  "author": "Stoplight <support@stoplight.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/stoplightio/elements"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./styles.min.css": "./styles.min.css",
    "./web-components.min.js": "./web-components.min.js",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "**/*"
  ],
  "scripts": {
    "build": "npm run version.set && npm run build.react && npm run build.webcomponents",
    "postbuild": "npm run build.styles",
    "build.react": "vite build -c vite.build.config.mts && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --declarationDir dist && node ../../scripts/prepare-dist.mjs",
    "build.webcomponents": "vite build -c vite.web-components.config.mts",
    "build.docs": "storybook build -c .storybook -o dist-storybook",
    "build.styles": "postcss src/styles.css -o dist/styles.min.css",
    "version.set": "node ../../scripts/set-version.mjs",
    "commit": "git-cz",
    "storybook": "npm run version.set && storybook dev -p 9001",
    "test": "vitest run",
    "test.prod": "vitest run --coverage --maxWorkers=2",
    "test.update": "vitest run --update",
    "test.watch": "vitest",
    "test.packaging": "node --input-type=module -e \"import './dist/index.js'\" && node -e \"require('./dist/index.js')\"",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=19.2.7",
    "react-dom": ">=19.2.7"
  },
  "rollup": {
    "bundleDeps": [
      "@fortawesome/free-solid-svg-icons",
      "use-debounce"
    ]
  },
  "dependencies": {
    "@scarf/scarf": "^1.4.0",
    "@stoplight/elements-core": "~10.0.0",
    "@stoplight/markdown-viewer": "^5.7.1",
    "@stoplight/mosaic": "^1.53.5",
    "@stoplight/path": "^1.3.2",
    "@stoplight/types": "^14.0.0",
    "@tanstack/react-query": "^5.104.0",
    "classnames": "^2.2.6",
    "lodash": "^4.17.21",
    "react-router": "^8.5.0",
    "use-debounce": "^6.0.1"
  },
  "devDependencies": {
    "@fortawesome/free-solid-svg-icons": "^6.1.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash": "4.17.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.3"
  },
  "publishConfig": {
    "directory": "dist"
  }
}
