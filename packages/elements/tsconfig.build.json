{
  "extends": "./tsconfig.json",
  "include": [
    "src"
  ],
  "exclude": [
    "**/__*__/**",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "./src",
    "moduleResolution": "bundler",
    "customConditions": ["require"],
    "paths": {
      "@stoplight/elements-core": ["../elements-core/dist"],
      "@stoplight/elements-core/*": ["../elements-core/dist/*"],
    }
  }
}
