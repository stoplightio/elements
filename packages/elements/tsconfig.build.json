{
  "extends": "./tsconfig.json",
  "include": [
    "src"
  ],
  "exclude": [
    "**/__*__/**",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "dist",
    "moduleResolution": "node",
    "paths": {
      "@stoplight/elements-core": ["../elements-core/dist"],
      "@stoplight/elements-core/*": ["../elements-core/dist/*"],
    }
  }
}
