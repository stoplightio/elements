{
  "name": "@stoplight/elements-core",
  "version": "10.0.0",
  "sideEffects": [
    "web-components.min.js",
    "src/web-components/**",
    "**/*.css"
  ],
  "homepage": "https://github.com/stoplightio/elements",
  "bugs": "https://github.com/stoplightio/elements/issues",
  "author": "Stoplight <support@stoplight.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/stoplightio/elements"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "**/*"
  ],
  "scripts": {
    "build": "npm run build.react",
    "postbuild": "npm run build.styles",
    "build.react": "vite build -c vite.build.config.mts && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --declarationDir dist && node ../../scripts/prepare-dist.mjs",
    "build.styles": "postcss src/styles.css -o dist/styles.min.css && cp src/core.css dist",
    "build.docs": "storybook build -o dist-storybook",
    "commit": "git-cz",
    "storybook": "storybook dev -p 9001",
    "test": "vitest run",
    "test.prod": "vitest run --coverage --maxWorkers=2",
    "test.update": "vitest run --update",
    "test.watch": "vitest",
    "test.packaging": "node --input-type=module -e \"import './dist/index.js'\" && node -e \"require('./dist/index.js')\"",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=19.2.7",
    "react-dom": ">=19.2.7"
  },
  "rollup": {
    "bundleDeps": [
      "@fortawesome/free-solid-svg-icons"
    ]
  },
  "dependencies": {
    "@scarf/scarf": "^1.4.0",
    "@stoplight/http-spec": "^7.1.0",
    "@stoplight/json": "^3.21.0",
    "@stoplight/json-schema-ref-parser": "^9.2.7",
    "@stoplight/json-schema-sampler": "0.3.0",
    "@stoplight/json-schema-tree": "^4.0.0",
    "@stoplight/json-schema-viewer": "4.16.3",
    "@stoplight/markdown-viewer": "^5.7.1",
    "@stoplight/mosaic": "^1.53.5",
    "@stoplight/mosaic-code-editor": "^1.53.5",
    "@stoplight/mosaic-code-viewer": "^1.53.5",
    "@stoplight/path": "^1.3.2",
    "@stoplight/react-error-boundary": "^3.0.0",
    "@stoplight/types": "^14.1.1",
    "@stoplight/yaml": "^4.3.0",
    "@tanstack/react-query": "^5.104.0",
    "classnames": "^2.2.6",
    "httpsnippet-lite": "^3.0.5",
    "jotai": "3.0.1",
    "json-schema": "^0.4.0",
    "lodash": "^4.17.21",
    "nanoid": "^3.1.32",
    "prop-types": "^15.7.2",
    "react-router": "^8.5.0",
    "tslib": "^2.1.0",
    "urijs": "^1.19.11",
    "util": "^0.12.4",
    "xml-formatter": "^3.6.3"
  },
  "devDependencies": {
    "@fortawesome/free-solid-svg-icons": "^6.1.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/classnames": "^2.2.10",
    "@types/json-schema": "^7.0.11",
    "@types/lodash": "^4.14.202",
    "@types/prop-types": "^15.7.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/urijs": "^1.19.19",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.3"
  },
  "publishConfig": {
    "directory": "dist"
  }
}
