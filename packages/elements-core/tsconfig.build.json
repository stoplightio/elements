{
  "extends": "./tsconfig.json",
  "include": [
    "src"
  ],
  "exclude": [
    "**/__*__/**",
    "**/utils/tests/**",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "./src",
    "moduleResolution": "bundler",
    "customConditions": ["require"]
  }
}
