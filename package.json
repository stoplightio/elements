{
  "name": "root",
  "private": true,
  "homepage": "https://github.com/stoplightio/elements",
  "bugs": "https://github.com/stoplightio/elements/issues",
  "author": "Stoplight <support@stoplight.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/stoplightio/elements"
  },
  "license": "Apache-2.0",
  "workspaces": [
    "demo",
    "packages/*"
  ],
  "devDependencies": {
    "@babel/core": "^7.17.9",
    "@babel/preset-env": "^7.23.3",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@playwright/test": "1.64.1",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-styling-webpack": "^3.0.2",
    "@storybook/addon-webpack5-compiler-swc": "^4.0.3",
    "@storybook/react": "10.6.3",
    "@storybook/react-webpack5": "10.6.3",
    "@testing-library/jest-dom": "^6",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "8.2.2",
    "css-loader": "6.7.1",
    "cssnano": "5.0.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-storybook": "10.6.3",
    "jsdom": "30.1.3",
    "lerna": "^7.4.2",
    "postcss": "8.5.23",
    "postcss-cli": "8.3.1",
    "postcss-import": "16.1.0",
    "postcss-loader": "8.1.1",
    "prettier": "2.8.8",
    "process": "0.11.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.3",
    "style-loader": "^3.3.3",
    "tsconfig-paths-webpack-plugin": "^3.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "url": "^0.11.4",
    "vite": "^8.3.5",
    "vitest": "5.0.5",
    "vitest-fetch-mock": "0.4.5",
    "webpack": "5.104.1",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "4.15.1"
  },
  "overrides": {
    "fast-xml-parser": "4.5.5",
    "xml-parser-xo": "4.1.5",
    "@types/react": "19.3.0",
    "tar": "6.2.1",
    "micromatch": "4.0.8",
    "@stoplight/react-error-boundary": "3.0.0",
    "lodash": "^4.18.1",
    "yaml": "2.8.3",
    "brace-expansion": "2.0.2",
    "tmp": "0.2.7",
    "js-cookie": "3.0.7",
    "http-cache-semantics": "4.3.0",
    "ip-address": "10.1.1",
    "webpack": "5.104.1",
    "form-data": "^4.0.6",
    "websocket-driver": "^0.7.5",
    "braces": "^3.0.3",
    "node-forge": "^1.3.2",
    "shell-quote": "^1.8.5",
    "rollup": "^4.59.0",
    "piscina": "^4.9.3",
    "webpack-dev-middleware": "^6.1.2",
    "serialize-javascript": "^7.0.3",
    "pacote": "^21.5.1",
    "use-resize-observer": {
      "react": "^19.0.0",
      "react-dom": "^19.0.0"
    },
    "npm": "11.19.1"
  },
  "scripts": {
    "build": "npm run build -w @stoplight/elements-core && npm run build -w @stoplight/elements && npm run build -w @stoplight/elements-dev-portal",
    "build.docs": "npm run build.docs -w @stoplight/elements",
    "postbuild": "npm run test.packaging -w @stoplight/elements && npm run test.packaging -w @stoplight/elements-core && npm run test.packaging -w @stoplight/elements-dev-portal",
    "lint": "eslint 'packages/*/src/**/*.{ts,tsx}'",
    "version": "lerna version --no-push",
    "release": "lerna publish from-package --yes --registry https://registry.npmjs.org --loglevel silly",
    "release.docs": "npm run release.docs -w @stoplight/elements",
    "type-check": "npm run type-check --workspaces --if-present && tsc -p e2e",
    "test": "npm test -w @stoplight/elements && npm test -w @stoplight/elements-core && npm test -w @stoplight/elements-dev-portal -- --passWithNoTests",
    "test.prod": "npm run test.prod -w @stoplight/elements && npm run test.prod -w @stoplight/elements-core && npm run test.prod -w @stoplight/elements-dev-portal -- --passWithNoTests",
    "prepublishOnly": "npm run build",
    "/// examples ///": "",
    "copy:angular": "mkdir examples-dev ; cp -a -v ./examples/angular ./examples-dev ; sh ./use-local-elements.sh angular",
    "build:angular": "(cd ./examples-dev/angular && npm run reinstall && npm run build)",
    "serve:angular": "(cd ./examples-dev/angular && npm run serve)",
    "copy:react-vite": "mkdir examples-dev ; cp -a -v ./examples/react-vite ./examples-dev ; sh ./use-local-elements.sh react-vite",
    "build:react-vite": "(cd ./examples-dev/react-vite && npm run reinstall && npm run build)",
    "serve:react-vite": "(cd ./examples-dev/react-vite && npm run serve)",
    "copy:static-html": "mkdir examples-dev ; cp -a -v ./examples/static-html ./examples-dev ; sh ./use-local-elements.sh static-html",
    "build:static-html": "(cd ./examples-dev/static-html && npm run reinstall && npm run build)",
    "serve:static-html": "(cd ./examples-dev/static-html && npm run serve)",
    "/// e2e ///": "",
    "e2e:open": "playwright test --ui",
    "e2e:execute": "playwright test",
    "e2e:run:angular": "EXAMPLE=angular playwright test",
    "e2e:run:react-vite": "EXAMPLE=react-vite playwright test",
    "e2e:run:static-html": "EXAMPLE=static-html playwright test"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged"
    }
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-conventional-changelog"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "allowScripts": {
    "@fortawesome/fontawesome-common-types": false,
    "@fortawesome/fontawesome-svg-core": false,
    "@fortawesome/free-solid-svg-icons": false,
    "@parcel/watcher": false,
    "@scarf/scarf": false,
    "@swc/core": false,
    "esbuild": false,
    "nx": false
  }
}
