{
  "extends": "@stoplight/scripts/tsconfig.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "baseUrl": "./packages",
    "lib": ["es2021", "dom"],
    "moduleResolution": "bundler",
    "customConditions": ["require"],
    "types": ["node", "vitest/globals", "@testing-library/jest-dom/vitest"],
    "paths": {
      "@test-utils/*": ["../test-utils/*"],
      "@stoplight/elements": ["./elements/src"],
      "@stoplight/elements/*": ["./elements/src/*"],
      "@stoplight/elements-dev-portal": ["./elements-dev-portal/src"],
      "@stoplight/elements-dev-portal/*": ["./elements-dev-portal/src/*"],
      "@stoplight/elements-core": ["./elements-core/src"],
      "@stoplight/elements-core/*": ["./elements-core/src/*"]
    }
  }
}
